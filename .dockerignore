# What must NOT end up in the image.
#
# The key one is .env: it holds the bot token and the DSM password, and
# `COPY . .` would pull it into an image layer, where `docker history` finds it.
.env
.env.*
!.env.example

.git
.gitignore
.idea
.vscode

# Installed and built inside the image anew.
web/node_modules
web/dist
internal/web/dist

# Everything a running service does not need.
docs
deploy
*.md
!README.md
.github
.gitlab-ci.yml

# Local databases and temporary files.
*.db
*.db-shm
*.db-wal
data
