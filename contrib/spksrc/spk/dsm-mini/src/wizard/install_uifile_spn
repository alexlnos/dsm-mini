[
   {
      "step_title": "Acceso al NAS",
      "items": [
         {
            "desc": "Cree un usuario de DSM propio para el servicio en lugar de usar un administrador: Panel de control → Usuario y grupo → Crear. Permita solo Download Station y File Station, y no active la verificación en dos pasos."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_url",
                  "desc": "Dirección de DSM",
                  "defaultValue": "https://localhost:5001",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio",
                     "regex": {
                        "expr": "/^https?:\\/\\/[^\\/]+$/",
                        "errorText": "Debe empezar por https:// y sin barra final"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_user",
                  "desc": "Usuario de DSM",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio"
                  }
               }
            ]
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_dsm_password",
                  "desc": "Contraseña de DSM",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio"
                  }
               }
            ]
         }
      ]
   },
   {
      "step_title": "Telegram",
      "items": [
         {
            "desc": "Cree un bot con @BotFather y obtenga su identificador numérico en @userinfobot."
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_bot_token",
                  "desc": "Token del bot",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio"
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_allowed_ids",
                  "desc": "IDs de Telegram permitidos (separados por comas)",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio",
                     "regex": {
                        "expr": "/^[0-9]+(,[0-9]+)*$/",
                        "errorText": "Solo dígitos y comas"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_public_url",
                  "desc": "Dirección HTTPS pública de la aplicación",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio",
                     "regex": {
                        "expr": "/^https:\\/\\/[^\\/]+$/",
                        "errorText": "Debe empezar por https:// y sin barra final"
                     }
                  }
               }
            ]
         },
         {
            "desc": "Telegram abre la Mini App solo por HTTPS con un certificado válido. Configure en DSM un proxy inverso desde esta dirección a localhost y el puerto de abajo."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_port",
                  "desc": "Puerto local",
                  "defaultValue": "8080",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obligatorio",
                     "regex": {
                        "expr": "/^[0-9]{2,5}$/",
                        "errorText": "Solo el número de puerto"
                     }
                  }
               }
            ]
         }
      ]
   }
]
