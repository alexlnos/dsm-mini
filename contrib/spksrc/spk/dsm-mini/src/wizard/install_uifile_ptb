[
   {
      "step_title": "Acesso ao NAS",
      "items": [
         {
            "desc": "Crie um usuário do DSM só para o serviço em vez de usar um administrador: Painel de controle → Usuário e grupo → Criar. Libere apenas Download Station e File Station e não ative a verificação em duas etapas."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_url",
                  "desc": "Endereço do DSM",
                  "defaultValue": "https://localhost:5001",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório",
                     "regex": {
                        "expr": "/^https?:\\/\\/[^\\/]+$/",
                        "errorText": "Deve começar com https:// e sem barra no final"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_user",
                  "desc": "Usuário do DSM",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório"
                  }
               }
            ]
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_dsm_password",
                  "desc": "Senha do DSM",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório"
                  }
               }
            ]
         }
      ]
   },
   {
      "step_title": "Telegram",
      "items": [
         {
            "desc": "Crie um bot com @BotFather e pegue seu identificador numérico com @userinfobot."
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_bot_token",
                  "desc": "Token do bot",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório"
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_allowed_ids",
                  "desc": "IDs do Telegram permitidos (separados por vírgula)",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório",
                     "regex": {
                        "expr": "/^[0-9]+(,[0-9]+)*$/",
                        "errorText": "Apenas dígitos e vírgulas"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_public_url",
                  "desc": "Endereço HTTPS público do aplicativo",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório",
                     "regex": {
                        "expr": "/^https:\\/\\/[^\\/]+$/",
                        "errorText": "Deve começar com https:// e sem barra no final"
                     }
                  }
               }
            ]
         },
         {
            "desc": "O Telegram abre o Mini App apenas por HTTPS com certificado válido. Configure no DSM um proxy reverso desse endereço para localhost e a porta abaixo."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_port",
                  "desc": "Porta local",
                  "defaultValue": "8080",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "Campo obrigatório",
                     "regex": {
                        "expr": "/^[0-9]{2,5}$/",
                        "errorText": "Apenas o número da porta"
                     }
                  }
               }
            ]
         }
      ]
   }
]
