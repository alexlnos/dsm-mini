[
   {
      "step_title": "NAS access",
      "items": [
         {
            "desc": "Create a separate DSM user for this service instead of using an administrator: Control Panel → User & Group → Create. Give it access to Download Station and File Station only, and do not enable two-factor authentication."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_url",
                  "desc": "DSM address",
                  "defaultValue": "https://localhost:5001",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^https?:\\/\\/[^\\/]+$/",
                        "errorText": "Must start with https:// and contain no trailing slash"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_user",
                  "desc": "DSM user",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  }
               }
            ]
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_dsm_password",
                  "desc": "DSM password",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  }
               }
            ]
         }
      ]
   },
   {
      "step_title": "Telegram",
      "items": [
         {
            "desc": "Create a bot with @BotFather and get your numeric ID from @userinfobot."
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_bot_token",
                  "desc": "Bot token",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_allowed_ids",
                  "desc": "Allowed Telegram IDs (comma separated)",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^[0-9]+(,[0-9]+)*$/",
                        "errorText": "Digits and commas only"
                     }
                  }
               }
            ]
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_public_url",
                  "desc": "Public HTTPS address of the app",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^https:\\/\\/[^\\/]+$/",
                        "errorText": "Must start with https:// and contain no trailing slash"
                     }
                  }
               }
            ]
         },
         {
            "desc": "Telegram opens the Mini App only over HTTPS with a valid certificate. Set up a reverse proxy in DSM from this address to localhost and the port below."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_port",
                  "desc": "Local port",
                  "defaultValue": "8080",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^[0-9]{2,5}$/",
                        "errorText": "Port number only"
                     }
                  }
               }
            ]
         }
      ]
   }
]
