[
   {
      "step_title": "NAS access",
      "items": [
         {
            "desc": "The service signs in to DSM the way you do, and it can delete files. Give it an account of its own rather than an administrator: Control Panel → User & Group → Create, access to Download Station and File Station only."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_url",
                  "desc": "DSM address",
                  "defaultValue": "https://localhost:5001",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^https?:\\/\\/[^\\/]+$/",
                        "errorText": "Must start with https:// and have no trailing slash"
                     }
                  }
               }
            ]
         },
         {
            "desc": "Leave this as it is. The service runs on this NAS and reaches DSM through the machine itself; 5001 is the HTTPS port, 5000 the HTTP one."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_dsm_user",
                  "desc": "DSM user for the service",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  },
                  "emptyText": "dsm-mini"
               }
            ]
         },
         {
            "desc": "The account you have just created. Do not turn on two-factor verification for it: a one-time code cannot be typed in from a configuration file, and the sign-in will simply fail."
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_dsm_password",
                  "desc": "Password of that user",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  }
               }
            ]
         },
         {
            "desc": "Kept on this NAS in the package's own settings file, readable by root only, and never written to the log — a refusal is logged with its reason, not with the value."
         }
      ]
   },
   {
      "step_title": "Telegram",
      "items": [
         {
            "desc": "The bot is the entrance: people write to it, and the app opens from it."
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_bot_token",
                  "desc": "Bot token",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required"
                  },
                  "emptyText": "8929377165:AAFHfZfqKDUEFdv-Yq4TJ9etz4"
               }
            ]
         },
         {
            "desc": "Open @BotFather in Telegram, send /newbot, and it answers with a line like the one shown here. Whoever holds the token controls the bot, so treat it as a password."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_allowed_ids",
                  "desc": "Who may use the bot — numeric IDs, comma separated",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^[0-9]+(,[0-9]+)*$/",
                        "errorText": "Digits and commas only"
                     }
                  },
                  "emptyText": "123456789,987654321"
               }
            ]
         },
         {
            "desc": "Your bot is public: anyone who finds it can press Start. This list is what decides whose messages are answered and who may open the app — everyone else is refused. Get your number from @userinfobot; it is the account id, not the @username. An empty list lets nobody in, not everybody."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_public_url",
                  "desc": "Public HTTPS address of the app",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^https:\\/\\/[^\\/]+$/",
                        "errorText": "Must start with https:// and have no trailing slash"
                     }
                  },
                  "emptyText": "https://nas.example.com"
               }
            ]
         },
         {
            "desc": "Telegram opens a Mini App only over https with a real certificate: a local address or a self-signed one will not open. Point this name at the NAS, then add Control Panel → Login Portal → Advanced → Reverse Proxy from it to localhost and the port below. No slash at the end."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_port",
                  "desc": "Local port on the NAS",
                  "defaultValue": "8080",
                  "validator": {
                     "allowBlank": false,
                     "errorText": "This field is required",
                     "regex": {
                        "expr": "/^[0-9]{2,5}$/",
                        "errorText": "Port number only"
                     }
                  }
               }
            ]
         },
         {
            "desc": "The service listens on this port for the NAS itself, not for the outside world. Change it only if something here already holds 8080."
         }
      ]
   }
]
