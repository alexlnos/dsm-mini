#!/bin/sh
# Runs after the package files are in place, on an install and on an upgrade.
#
# It has nothing to do. There is no install wizard: the service starts without
# settings, and they are entered in its window in the DSM main menu, which is
# also where they are changed later. The script stays because DSM expects the
# full set — a missing preupgrade or postupgrade makes an upgrade from a
# package source fail with code 261 — and a missing postinst is not worth
# finding out about the same way.
exit 0
