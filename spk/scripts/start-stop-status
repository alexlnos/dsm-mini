#!/bin/sh
# Управление службой для Центра пакетов DSM.
#
# DSM 7 запускает этот скрипт от пользователя пакета, а не от root — так
# требует conf/privilege. Поэтому всё, что служба пишет, лежит в var пакета:
# туда у неё есть права, и этот каталог переживает обновление.
#
# Сообщения наружу — по-английски: их читает тот, кто ставит пакет, а он
# может быть откуда угодно.

PKG="dsm-mini"
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"

BIN="$TARGET/bin/$PKG"
ENV_FILE="$VAR/config.env"
PID_FILE="$VAR/$PKG.pid"
LOG_FILE="$VAR/$PKG.log"

running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    running && return 0

    [ -x "$BIN" ] || { echo "Executable not found: $BIN" >&2; return 1; }
    [ -r "$ENV_FILE" ] || { echo "Configuration not found: $ENV_FILE" >&2; return 1; }

    # Настройки лежат отдельным файлом, а не внутри пакета: их правят после
    # установки, не переустанавливая его.
    set -a
    . "$ENV_FILE"
    set +a
    STATE_DIR="$VAR"
    export STATE_DIR

    "$BIN" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # Даём службе мгновение на падение: без этого Центр пакетов покажет
    # «запущено» у процесса, который уже умер на неверном токене.
    sleep 2
    if ! running; then
        echo "Service exited on startup, see $LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 2>/dev/null
        return 1
    fi
    return 0
}

stop_service() {
    if ! running; then
        rm -f "$PID_FILE"
        return 0
    fi
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null

    # Службе нужно время закрыть базу и отпустить long polling Telegram.
    i=0
    while [ $i -lt 15 ]; do
        running || break
        sleep 1
        i=$((i + 1))
    done
    running && kill -9 "$pid" 2>/dev/null

    rm -f "$PID_FILE"
    return 0
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    status)
        # Коды выхода определены DSM: 0 — работает, 3 — не работает.
        if running; then exit 0; else exit 3; fi
        ;;
    log)
        echo "$LOG_FILE"
        ;;
    *)
        echo "usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
