#!/bin/sh
# Service control for the DSM Package Center.
#
# DSM 7 runs this script as the package user rather than root — conf/privilege
# requires it. So everything the service writes lives in the package var: it
# has permission there, and that directory survives an upgrade.
#
# Messages going out are in English: they are read by whoever installs the
# package, and they may be from anywhere.

PKG="dsm-mini"
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"

BIN="$TARGET/bin/$PKG"
ENV_FILE="$VAR/config.env"
PID_FILE="$VAR/$PKG.pid"
LOG_FILE="$VAR/$PKG.log"

running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    running && return 0

    [ -x "$BIN" ] || { echo "Executable not found: $BIN" >&2; return 1; }
    [ -r "$ENV_FILE" ] || { echo "Configuration not found: $ENV_FILE" >&2; return 1; }

    # The settings live in a separate file rather than inside the package:
    # they are edited after installation without reinstalling it.
    set -a
    . "$ENV_FILE"
    set +a

    # The settings screen in DSM is served by DSM's own web server, under a
    # different user that cannot read config.env (0600). It still has to know
    # which port to reach the service on, so the port — and only the port —
    # is written next to the page, where that user may read it.
    port="${LISTEN_ADDR##*:}"
    case "$port" in
        ''|*[!0-9]*) port=8080 ;;
    esac
    if [ -d "$TARGET/ui" ]; then
        printf 'PORT=%s\n' "$port" > "$TARGET/ui/backend.conf" 2>/dev/null || true
    fi
    STATE_DIR="$VAR"
    export STATE_DIR

    "$BIN" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # Give the service a moment to die: without this the Package Center would
    # show "running" for a process that already exited on a wrong token.
    sleep 2
    if ! running; then
        echo "Service exited on startup, see $LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 2>/dev/null
        return 1
    fi
    return 0
}

stop_service() {
    if ! running; then
        rm -f "$PID_FILE"
        return 0
    fi
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null

    # The service needs time to close the database and release the long polling.
    i=0
    while [ $i -lt 15 ]; do
        running || break
        sleep 1
        i=$((i + 1))
    done
    running && kill -9 "$pid" 2>/dev/null

    rm -f "$PID_FILE"
    return 0
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    status)
        # The exit codes are defined by DSM: 0 — running, 3 — not running.
        if running; then exit 0; else exit 3; fi
        ;;
    log)
        echo "$LOG_FILE"
        ;;
    *)
        echo "usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
