#!/bin/sh
# Service control for the DSM Package Center.
#
# DSM 7 runs this script as the package user rather than root — conf/privilege
# requires it. So everything the service writes lives in the package var: it
# has permission there, and that directory survives an upgrade.
#
# Nothing here reads the settings. The service reads config.env itself, and
# starts without one: a fresh package is set up in its window in the DSM main
# menu, and a save there applies without this script being involved.
#
# Messages going out are in English: they are read by whoever installs the
# package, and they may be from anywhere.

PKG="dsm-mini"
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"

BIN="$TARGET/bin/$PKG"
PID_FILE="$VAR/$PKG.pid"
LOG_FILE="$VAR/$PKG.log"

running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    running && return 0

    [ -x "$BIN" ] || { echo "Executable not found: $BIN" >&2; return 1; }

    # A log left by a build of the package that ran as another user cannot
    # be appended to, and a redirection that fails means the service is never
    # started at all. It is set aside rather than lost: it may be the only
    # account of what happened before.
    if [ -e "$LOG_FILE" ] && [ ! -w "$LOG_FILE" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.unreadable" 2>/dev/null || true
    fi

    # STATE_DIR is where config.env and the database live. UI_DIR is the
    # settings window, which the service tells which port it listens on: the
    # window's CGI runs as DSM's web server and cannot read config.env.
    STATE_DIR="$VAR"
    UI_DIR="$TARGET/ui"
    export STATE_DIR UI_DIR

    "$BIN" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # Give the service a moment to die: without this the Package Center would
    # show "running" for a process that already exited. Settings that are
    # missing or wrong no longer do that — the service stays up and says so in
    # its window — but a port somebody else holds still does.
    sleep 2
    if ! running; then
        echo "Service exited on startup, see $LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 2>/dev/null
        return 1
    fi
    return 0
}

stop_service() {
    if ! running; then
        rm -f "$PID_FILE"
        return 0
    fi
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null

    # The service needs time to close the database and release the long polling.
    i=0
    while [ $i -lt 15 ]; do
        running || break
        sleep 1
        i=$((i + 1))
    done
    running && kill -9 "$pid" 2>/dev/null

    rm -f "$PID_FILE"
    return 0
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    status)
        # The exit codes are defined by DSM: 0 — running, 3 — not running.
        if running; then exit 0; else exit 3; fi
        ;;
    log)
        echo "$LOG_FILE"
        ;;
    *)
        echo "usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
