# ── Synology DSM ───────────────────────────────────────────────────────────
# Адрес DSM. Порт 5001 — HTTPS, 5000 — HTTP.
DSM_URL=https://192.168.1.10:5001

# Учётная запись DSM. Настоятельно рекомендуется завести ОТДЕЛЬНОГО
# пользователя с доступом только к Download Station, а не использовать админа:
# DSM → Панель управления → Пользователи → Создать, права только на нужный пакет.
DSM_USER=dsm-mini
DSM_PASSWORD=

# Код 2FA, если у учётной записи включена двухэтапная проверка.
# Одноразовый код здесь работать не будет — заведите пользователя без 2FA.
# DSM_OTP=

# У DSM по умолчанию самоподписанный сертификат. true — не проверять его.
# Оставляйте false, если у вас на DSM валидный сертификат.
DSM_INSECURE_TLS=true

# ── Telegram ───────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Кому разрешён доступ — Telegram user ID через запятую. Пусто = никому.
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Публичный HTTPS-адрес Mini App. Telegram открывает только HTTPS
# с валидным сертификатом — самоподписанный не подойдёт.
PUBLIC_URL=https://ds.example.com

# ── Сервис ─────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080

# Как часто опрашивать Download Station для уведомлений о завершении задач.
WATCH_INTERVAL=30s

# Каталог с базой SQLite (настройки и состояние задач).
# В контейнере это том, переживающий пересоздание.
STATE_DIR=/data

# debug | info | warn | error
LOG_LEVEL=info
