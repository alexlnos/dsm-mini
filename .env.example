# ── Synology DSM ───────────────────────────────────────────────────────────
# The DSM address. Port 5001 is HTTPS, 5000 is HTTP.
DSM_URL=https://192.168.1.10:5001

# The DSM account. Creating a SEPARATE user with access only to Download
# Station is strongly recommended over using the admin:
# DSM → Control Panel → User → Create, permissions for the needed package only.
DSM_USER=dsm-mini
DSM_PASSWORD=

# The 2FA code when the account has two-factor verification enabled.
# A one-time code will not work here — create a user without 2FA.
# DSM_OTP=

# DSM ships with a self-signed certificate. true means do not verify it.
# Leave it false when your DSM has a valid certificate.
DSM_INSECURE_TLS=true

# ── Telegram ───────────────────────────────────────────────────────────────
# The bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Who is allowed in — Telegram user IDs separated by commas. Empty = nobody.
# @userinfobot tells you your own ID.
ALLOWED_USER_IDS=

# The public HTTPS address of the Mini App. Telegram opens only HTTPS with a
# valid certificate — a self-signed one will not do.
PUBLIC_URL=https://ds.example.com

# ── Service ────────────────────────────────────────────────────────────────
# Loopback only — the DSM reverse proxy connects through localhost.
# Use 0.0.0.0:58080 during development if you open the app from another machine.
LISTEN_ADDR=127.0.0.1:58080

# How often to poll Download Station for finished-task notifications.
WATCH_INTERVAL=30s

# The directory with config.env and the SQLite database. The DSM package sets
# this to its own var directory, which survives an upgrade. For a local run
# any writable directory will do. A config.env there wins over the variables
# in this file: they only fill in what it does not say.
STATE_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info
